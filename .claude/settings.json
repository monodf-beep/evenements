{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(*--hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DELETE FROM*)",
      "Bash(*TRUNCATE*)",
      "Bash(*force=true*)",
      "Bash(*--force-delete*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(crontab -r:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(systemctl:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Edit(./.claude/settings.json)"
    ],
    "allow": [
      "Bash(.venv/bin/python:*)",
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(crontab:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(tmux:*)"
    ]
  }
}
