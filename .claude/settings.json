{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(*--hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DELETE FROM*)",
      "Bash(*TRUNCATE*)",
      "Bash(crontab -r:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(*--apply*)",
      "Bash(*--execute*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(crontab:*)",
      "Bash(*trash*)",
      "Bash(*publish*)",
      "Bash(systemctl:*)",
      "Bash(apt:*)",
      "Bash(pip install:*)",
      "Write(./crontab.txt)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(.venv/bin/python scripts/backup_db.py)",
      "Bash(.venv/bin/python -m scripts.audit_wp_ghosts:*)",
      "Bash(.venv/bin/python -m scripts.audit_dedupe_damage:*)",
      "Bash(.venv/bin/python scripts/count_grasse.py:*)",
      "Bash(.venv/bin/python scripts/status_report.py:*)",
      "Bash(.venv/bin/python scripts/diagnose_backlog.py:*)"
    ]
  }
}
