{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(*--hard*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DELETE FROM*)",
      "Bash(*TRUNCATE*)",
      "Bash(crontab -r:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(*--apply*)",
      "Bash(*--execute*)",
      "Bash(*--force*)",
      "Bash(*--retry*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(crontab:*)",
      "Bash(systemctl:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(pip install:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(curl -X:*)",
      "Bash(curl --request:*)",
      "Edit(./crontab.txt)",
      "Edit(./.claude/settings.json)"
    ],
    "allow": [
      "Bash(.venv/bin/python:*)",
      "Bash(python3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(crontab -l)",
      "Bash(curl -s:*)",
      "Bash(curl -sI:*)",
      "Bash(curl -fsSL:*)"
    ]
  }
}
