# ── Backoffice Agenda Cultura Sabauda — variables d'environnement ──
# Copier en .env et remplir. Ne JAMAIS committer .env (voir .gitignore).

# ── Anthropic (évaluation LLM) ──
# Même pattern que l'Observatoire : SDK anthropic direct.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modèle d'évaluation des événements. La flexibilité de modèle se gère ici.
# Modèles valides : claude-sonnet-5 (équilibré) · claude-haiku-4-5-20251001
# (économique, idéal budget serré) · claude-opus-4-8 (le plus fin).
ANTHROPIC_MODEL=claude-sonnet-5
# Modèle d'extraction des événements depuis les newsletters (gmail_collect).
# Peut être plus économique (extraction = tâche simple). Défaut = ANTHROPIC_MODEL.
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5-20251001

# ── Datation LLM (scripts/dates.py — 3ᵉ passe, dernier recours) ──
# Quand le regex (texte) ET le JSON-LD (page) échouent, un LLM lit la prose de la
# page pour en tirer la date de l'événement (surtout utile pour les pages IT).
# Économique, borné, idempotent. Mettre DATES_LLM=0 pour désactiver (ex. en cron).
DATES_LLM=1
DATES_LLM_CAP=150
DATES_LLM_MODEL=claude-haiku-4-5-20251001

# ── Enrichissement + rédaction (scripts/enrich.py — recherche web) ──
# Agent qui, sur les événements RETENUS, cherche le contexte (source officielle
# libre, jamais de paywall) et rédige un article à relire. Coûteux → maîtrisé.
# Modèle compatible recherche web : claude-sonnet-5 (défaut) / claude-opus-4-8.
ANTHROPIC_MODEL_ENRICH=claude-sonnet-5
# Seuil : on n'enrichit que les événements de score ≥ cette valeur (défaut 7).
ENRICH_MIN_SCORE=7
# Nombre d'événements enrichis par lot (bouton « Enrichissement »). Défaut 10.
ENRICH_BATCH=10
# Plafond de recherches web par événement (outil serveur). Défaut 3.
ENRICH_MAX_SEARCHES=3
# L'agent rédige à partir de la PAGE OFFICIELLE récupérée par le code (fiable, par défaut).
# Options avancées (par défaut OFF — rapide, fiable, économique) :
#   ENRICH_WEB_SEARCH=1  ajoute l'outil de recherche web Anthropic (si activé sur la clé)
#   ENRICH_THINKING=1    active le raisonnement étendu (articles plus fouillés, plus lents/chers)
ENRICH_WEB_SEARCH=0
ENRICH_THINKING=0

# ── Visuels (scripts/visuals.py — bouton « Compléter les visuels ») ──
# Pour les retenus SANS image : og:image → photo licenciable Wikimedia Commons
# (le LLM rédige la requête) → bannière territoire (repli garanti). Léger et idempotent.
# Modèle de la requête visuelle (tâche simple → économique). Défaut = ANTHROPIC_MODEL_EXTRACT.
ANTHROPIC_MODEL_VISUALS=claude-haiku-4-5-20251001
# Plafond d'événements traités par lancement (garde-fou coût/temps).
VISUALS_CAP=80

# ── Canal Gmail (newsletters culturelles) ──
# OAuth2 read-only. Déposer config/credentials.json depuis Google Cloud Console,
# puis : python scripts/authorize_gmail.py (ou gmail_collect --setup) pour générer token.json.
GMAIL_LABEL=Agenda
GMAIL_LOOKBACK_DAYS=7
# Canal « dossiers de presse » (scripts/press_kits.py) : label où Franck dépose les
# mails d'accréditation / dossiers de presse (PDF + photos HD → matière primaire).
GMAIL_PRESSE_LABEL=Presse
GMAIL_PRESSE_LOOKBACK_DAYS=30
# Chemins (défauts sous config/). Ne JAMAIS committer ces fichiers.
GMAIL_CREDENTIALS=config/credentials.json
GMAIL_TOKEN=config/token.json

# ── Base de données SQLite ──
# Chemin du fichier SQLite (défaut : data/events.db sous la racine du projet).
DB_PATH=data/events.db

# ── Newsletter Brevo « Agenda Sabaudo » (scripts/newsletter.py — crée des BROUILLONS) ──
# Réutilise la même clé API que l'Observatoire. Rien n'est jamais envoyé automatiquement.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_NAME=Agenda Sabaudo
# Expéditeur VALIDÉ dans Brevo (pour le test : contact@culturasabauda.eu ; plus tard : agendasabaudo.eu).
BREVO_SENDER_EMAIL=contact@culturasabauda.eu
# id de la liste « Agenda Sabaudo — Newsletter » (vu dans Brevo → Contacts → Listes).
BREVO_LIST_ID=12
# Territoire couvert par la newsletter (v1 = Savoie).
NEWSLETTER_TERRITOIRE=Savoie
# (option) URL du logo Agenda Sabaudo hébergé (bibliothèque média Brevo) — masthead + pied.
BREVO_LOGO_URL=
# (option) Lien « Voir tout l'agenda de la période » (site de masse / tableau de bord public).
NEWSLETTER_DASHBOARD_URL=

# ── WordPress Cultura Sabauda (publication en draft) ──
WP_URL=https://culturasabauda.eu
WP_USER=franck
# Application Password WordPress (Utilisateurs → Profil → Mots de passe d'application).
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Backoffice Flask (page de connexion + session) ──
BACKOFFICE_USER=admin
BACKOFFICE_PASSWORD=change-me
# Clé de signature des cookies de session. Recommandé : une valeur aléatoire
# (ex. `python -c "import secrets; print(secrets.token_hex(32))"`). Si vide, une
# clé stable est dérivée des identifiants ci-dessus.
FLASK_SECRET_KEY=

# ── Domaine (documentaire uniquement, voir nginx.conf) ──
DOMAIN=agenda.culturasabauda.eu
